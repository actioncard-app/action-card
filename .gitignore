# Dependencies
node_modules/

# Build output (npm run build -> dist/, subpath test build -> dist-sub/)
dist/
dist-*/

# Generated at build time by scripts/make-icons.mjs (no binary files in the repo)
public/*.png
public/favicon.ico

# Generated at build time from npm packages by scripts/copy-ocr-assets.mjs
# (tesseract.js worker, tesseract.js-core WASM cores, @tesseract.js-data traineddata)
public/tesseract/

# Test outputs (accuracy reports, e2e/PWA JSON, Lighthouse) are regenerated by the test scripts
test-results/

# Sample document images and screenshots are binary; they are not in the repository (expected.json is)
test-docs/*.png
test-docs/*.jpg
screenshots/
playwright-report/
lighthouse-*.html

# Never commit keys or local env files (the xAI key lives only in the phone's localStorage)
.env
.env.*

# Logs, archives, OS/editor files
*.log
npm-debug.log*
*.tgz
.DS_Store
Thumbs.db
.vscode/
.idea/

# Simulated phone photos are generated by scripts/make_phone_photos.py (npm run make-phone-photos); expected.json is committed
test-docs/phone/*.jpg
test-docs/phone-rotated/*.jpg
test-docs/multipage/*.jpg
